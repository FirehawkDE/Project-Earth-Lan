# Als Administrator ausführen prüfen
If (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error "Bitte führen Sie dieses Skript als Administrator aus!"
    Exit
}

$NetworkId = "091f0945fc5012f1"
$NewAdapterName = "Project Earth Lan"
$InstallerPath = "$env:TEMP\ZeroTierOne.msi"
$DownloadUrl = "https://download.zerotier.com/dist/ZeroTier%20One.msi"

Write-Host "1. Lade ZeroTier One herunter..." -ForegroundColor Cyan
Invoke-WebRequest -Uri $DownloadUrl -OutFile $InstallerPath

Write-Host "2. Installiere ZeroTier One..." -ForegroundColor Cyan
Start-Process msiexec.exe -ArgumentList "/i `"$InstallerPath`" /qn /norestart" -Wait

Write-Host "3. Optimiere Dienst-Starttyp (Verzögerter Autostart)..." -ForegroundColor Cyan
Set-Service -Name "ZeroTierOneService" -StartupType Automatic
Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\ZeroTierOneService" -Name "DelayedAutostart" -Value 1

# Erstmaliger Dienst-Start nach Installation
Restart-Service -Name "ZeroTierOneService" -Force -ErrorAction SilentlyContinue

# Pfad zur CLI ermitteln
$cliPath = "C:\Program Files (x86)\ZeroTier\One\zerotier-cli.bat"
if (-not (Test-Path $cliPath)) {
    $cliPath = "C:\Program Files\ZeroTier\One\zerotier-cli.bat"
}

Write-Host "4. Warte auf vollständige Bereitschaft des ZeroTier-Dienstes..." -ForegroundColor Cyan
$timeout = 45
$elapsed = 0
do {
    Start-Sleep -Seconds 2
    $elapsed += 2
    $status = & $cliPath status 2>&1
} while ($status -like "*waiting*" -and $elapsed -lt $timeout)

Write-Host "5. Verbinde mit dem Netzwerk: $NetworkId..." -ForegroundColor Cyan
& $cliPath join $NetworkId

Write-Host "6. Warte auf Adapter-Erstellung und IP-Zuweisung..." -ForegroundColor Cyan
Start-Sleep -Seconds 8

Write-Host "7. Konfiguriere Metrik, MTU und Adapter-Namen..." -ForegroundColor Cyan
# Suche den Adapter anhand des Treibers / Beschreibung
$ztAdapter = Get-NetAdapter | Where-Object { $_.InterfaceDescription -like "*ZeroTier*" -or $_.Name -like "*ZeroTier*" }

$assignedIP = "Keine IP zugewiesen (Netzwerk-Freigabe im Controller ausstehend)"

if ($ztAdapter) {
    foreach ($adapter in $ztAdapter) {
        # MTU auf 1380 setzen
        Set-NetIPInterface -InterfaceIndex $adapter.ifIndex -NlMtu 1380 -ErrorAction SilentlyContinue
        
        # Metrik auf 1 setzen (IPv4 und IPv6)
        Set-NetIPInterface -InterfaceIndex $adapter.ifIndex -InterfaceMetric 1 -ErrorAction SilentlyContinue
        
        # IP-Adresse des Adapters ermitteln
        $ipObj = Get-NetIPAddress -InterfaceIndex $adapter.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue
        if ($ipObj) {
            $assignedIP = $ipObj.IPAddress
        }

        # Adapter im Netzwerk- und Freigabecenter umbenennen
        try {
            Rename-NetAdapter -InputObject $adapter -NewName $NewAdapterName -ErrorAction Stop
            Write-Host "Adapter erfolgreich umbenannt in: '$NewAdapterName'" -ForegroundColor Green
        } catch {
            Write-Warning "Adapter konnte nicht umbenannt werden (evtl. existiert der Name bereits)."
        }
        
        Write-Host "Adapter-Konfiguration abgeschlossen (MTU: 1380, Metrik: 1)." -ForegroundColor Green
    }
} else {
    Write-Warning "Der ZeroTier-Netzwerkadapter wurde noch nicht im System registriert."
}

# 8. Textdatei auf dem Desktop erstellen
$desktopPath = [Environment]::GetFolderPath("Desktop")
$filePath = Join-Path -Path $desktopPath -ChildPath "Deine ZeroTierOne IP.txt"

$fileContent = @"
========================================
       ZeroTier One IP-Adresse
========================================

Ihre ZeroTier IPv4-Adresse lautet:
$assignedIP

Netzwerk-Name: $NewAdapterName
Netzwerk-ID:   $NetworkId
Datum:         $(Get-Date -Format "dd.MM.yyyy HH:mm:ss")
========================================
"@

Set-Content -Path $filePath -Value $fileContent -Encoding UTF8
Write-Host "IP-Adresse wurde auf dem Desktop gespeichert: $filePath" -ForegroundColor Green

# 9. ZeroTier-Dienst am Ende nochmals neu starten
Write-Host "9. Starte ZeroTierOne-Dienst abschließend neu..." -ForegroundColor Cyan
Restart-Service -Name "ZeroTierOneService" -Force -ErrorAction SilentlyContinue

# Aufräumen
Remove-Item $InstallerPath -ErrorAction SilentlyContinue
Write-Host "Installation, Umbenennung und Konfiguration erfolgreich abgeschlossen!" -ForegroundColor Green
