# ==========================================
# 1. Administrator-Rechte prüfen & anfordern
# ==========================================
$currentPrincipal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $currentPrincipal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Start-Process powershell.exe "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`"" -Verb RunAs
    exit
}

# ==========================================
# 2. Einstellungen & Variablen
# ==========================================
$NetworkID = "091f0945fc744570"
$InstallerUrl = "https://download.zerotier.com/dist/ZeroTier%20One.msi"
$InstallerPath = "$env:TEMP\ZeroTierOneInstaller.msi"
$DesktopPath = [System.IO.Path]::Combine($env:USERPROFILE, "Desktop")
$TxtFile = Join-Path $DesktopPath "Project Earth Lan IP.txt"
$TargetMTU = 1380

# ==========================================
# 3. Download & Installation
# ==========================================
Write-Host "Lade ZeroTier One herunter..." -ForegroundColor Cyan
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
Invoke-WebRequest -Uri $InstallerUrl -OutFile $InstallerPath

Write-Host "Installiere ZeroTier One..." -ForegroundColor Cyan
$installProcess = Start-Process msiexec.exe -ArgumentList "/i `"$InstallerPath`" /qn /norestart" -Wait -PassThru

if ($installProcess.ExitCode -ne 0) {
    Write-Error "Installation fehlgeschlagen."
    exit
}

# PATH-Umgebungsvariable im laufenden Skript aktualisieren
$env:Path = [System.Environment]::GetEnvironmentVariable("Path","Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path","User")

# ==========================================
# 4. Service-Start abwarten & Join ausführen
# ==========================================
Write-Host "Warte auf ZeroTier-Dienst..." -ForegroundColor Cyan
while ((Get-Service -Name "ZeroTierOneService" -ErrorAction SilentlyContinue).Status -ne "Running") {
    Start-Sleep -Seconds 2
}

Start-Sleep -Seconds 3

Write-Host "Führe Join aus..." -ForegroundColor Cyan

# Versuche zuerst den direkten Pfad, falls PATH noch verzögert ist, sonst Standardbefehl
$cliExe = "$env:ProgramFiles\ZeroTier\One\zerotier-cli.exe"

if (Test-Path $cliExe) {
    cmd.exe /c "`"$cliExe`" join $NetworkID"
} else {
    cmd.exe /c "zerotier-cli join $NetworkID"
}

# ==========================================
# 5. IP-Adresse abwarten & in Datei schreiben
# ==========================================
Write-Host "Warte auf Zuweisung der IP-Adresse..." -ForegroundColor Cyan

$adapter = $null
$assignedIP = $null
$maxRetries = 30
$retryCount = 0

while ($retryCount -lt $maxRetries) {
    $adapter = Get-NetAdapter | Where-Object { $_.InterfaceDescription -like "*ZeroTier*" }
    
    if ($adapter) {
        $ipObj = Get-NetIPAddress -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue | 
                 Where-Object { $_.IPAddress -notlike "169.254.*" }

        if ($ipObj) {
            $assignedIP = $ipObj.IPAddress
            break
        }
    }
    
    Start-Sleep -Seconds 2
    $retryCount++
}

if (-not $assignedIP) {
    Write-Error "Keine IP-Adresse erhalten."
    exit
}

# IP auf dem Desktop speichern
Set-Content -Path $TxtFile -Value $assignedIP -Force
Write-Host "IP ($assignedIP) gespeichert in '$TxtFile'." -ForegroundColor Green

# ==========================================
# 6. Adapter-Metrik auf 1 & MTU setzen
# ==========================================
Write-Host "Setze Metrik auf 1 und MTU auf $TargetMTU..." -ForegroundColor Cyan

Set-NetIPInterface -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -InterfaceMetric 1
Set-NetIPInterface -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -NlMtuBytes $TargetMTU

# Aufräumen
Remove-Item -Path $InstallerPath -Force -ErrorAction SilentlyContinue

Write-Host "Vorgang erfolgreich abgeschlossen!" -ForegroundColor Green
